# graph-collab-service — Fastify + WebSocket hub
# Runs via tsx (workspace packages export ./src directly), so no compile step.
FROM node:22-slim

RUN corepack enable
WORKDIR /app

# Copy the whole monorepo (see .dockerignore — node_modules, data, secrets are
# excluded) so the pnpm workspace resolves with a frozen lockfile.
COPY . .
RUN pnpm install --frozen-lockfile

ENV COLLAB_PORT=4001 \
    GRAPHS_DIR=/app/graphs
EXPOSE 4001

CMD ["pnpm", "--filter", "@graphcraft/collab-service", "start"]
