# ── graph-collab-service ──────────────────────────────────────────────
COLLAB_PORT=4001
GRAPHS_DIR=./graphs
# Redis is OPTIONAL. Leave REDIS_URL empty to use the in-memory op-log
# fallback (single-process dev). Set it to enable multi-process / restart-safe
# session state.
REDIS_URL=

# ── auth-service ──────────────────────────────────────────────────────
AUTH_PORT=4000
# Switchable OAuth provider: "gitlab" | "github"
AUTH_PROVIDER=gitlab
# Base URL of the git host API (self-hosted GitLab, github.com, …)
GIT_URL=https://gitlab.com
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://127.0.0.1:4000/auth/callback
JWT_SECRET=dev-only-change-me
COOKIE_TOKEN_NAME=graphcraft.token
# Static service token the mcp-service/agent uses to join rooms.
AGENT_SERVICE_TOKEN=dev-agent-token

# ── mcp-service ───────────────────────────────────────────────────────
# Where the MCP server reaches the collab hub (ws) and its HTTP API.
COLLAB_WS_URL=ws://127.0.0.1:4001
COLLAB_HTTP_URL=http://127.0.0.1:4001

# ── frontend ──────────────────────────────────────────────────────────
FRONTEND_PORT=5173

# ── LLM (pluggable; default deepseek). T1 curation + keyless graph build ─
# need NONE of these. createLLM() auto-detects in this priority order:
# generic LLM_* override → deepseek → zai/GLM → openai. Used by the LLM graph
# builder (pnpm build:graph --llm) and the tier-3 skill compiler.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_API_KEY=
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4-plus
# Local GLM (host supplied later)
GLM_BASE_URL=
GLM_API_KEY=
GLM_MODEL=glm-4
# OpenAI / any OpenAI-compatible endpoint (Ollama, vLLM, …)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Generic override (wins over all above): point at any OpenAI-compat server.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ── embeddings (tier-2 skill compiler; OpenAI-compat) ─────────────────
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=
