# Copy to `.env` at the repo root to drive docker-compose.
# Anything left empty falls back to documented defaults.

# --- LLM (default provider for development and CI) ---------------------
DEEPSEEK__API_KEY=
# DEEPSEEK__MODEL=deepseek-chat

# --- Yandex (optional second provider) ---------------------------------
# YANDEX__FOLDER_ID=
# YANDEX__TOKEN=
# YANDEX__COMPLETION_MODEL=yandexgpt
# YANDEX__EMBEDDING_MODEL=text-search-query

# --- Postgres (any non-empty password flips backend to PG-backed repo) -
POSTGRES__USER=graphrag
POSTGRES__PASSWORD=changeme
POSTGRES__DATABASE=graphrag

# --- Frontend ----------------------------------------------------------
# NUXT_PUBLIC_API_BASE=http://backend:8000
# NUXT_API_PROXY_TARGET=http://backend:8000

# --- Misc --------------------------------------------------------------
# LOG_LEVEL=INFO
